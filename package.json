{
  "name": "markdown-wysiwyg",
  "displayName": "Markdown WYSIWYG",
  "description": "Edit markdown files in a Notion-style WYSIWYG editor, with easy switching back to the regular text editor.",
  "version": "0.4.0",
  "publisher": "NicholasPeretti",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onView:markdownWysiwyg.searchView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownWysiwyg.editor",
        "displayName": "Markdown WYSIWYG",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markdownWysiwyg.openWysiwyg",
        "title": "Markdown: Open in WYSIWYG Mode",
        "icon": "$(book)"
      },
      {
        "command": "markdownWysiwyg.openSource",
        "title": "Markdown: Open in Code Mode",
        "icon": "$(code)"
      },
      {
        "command": "markdownWysiwyg.toggleToc",
        "title": "Markdown: Toggle Table of Contents"
      },
      {
        "command": "markdownWysiwyg.rebuildQueryIndex",
        "title": "Markdown WYSIWYG: Rebuild Query Index"
      },
      {
        "command": "markdownWysiwyg.search",
        "title": "Markdown: Search Notes",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownWysiwyg",
          "title": "Notes",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "markdownWysiwyg": [
        {
          "type": "webview",
          "id": "markdownWysiwyg.searchView",
          "name": "Search Notes",
          "icon": "$(search)",
          "contextualTitle": "Search Notes"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownWysiwyg.openWysiwyg",
        "key": "ctrl+alt+m",
        "mac": "alt+cmd+m",
        "when": "activeCustomEditorId != markdownWysiwyg.editor && (resourceLangId == markdown || resourceExtname == .md || resourceExtname == .markdown)"
      },
      {
        "command": "markdownWysiwyg.openSource",
        "key": "ctrl+alt+m",
        "mac": "alt+cmd+m",
        "when": "activeCustomEditorId == markdownWysiwyg.editor"
      },
      {
        "command": "markdownWysiwyg.search",
        "key": "ctrl+shift+alt+f",
        "mac": "shift+alt+cmd+f"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownWysiwyg.openWysiwyg",
          "when": "resourceLangId == markdown && activeCustomEditorId != markdownWysiwyg.editor",
          "group": "navigation"
        },
        {
          "command": "markdownWysiwyg.openSource",
          "when": "activeCustomEditorId == markdownWysiwyg.editor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownWysiwyg.openWysiwyg",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdownWysiwyg.openSource",
          "when": "activeCustomEditorId == markdownWysiwyg.editor"
        },
        {
          "command": "markdownWysiwyg.toggleToc",
          "when": "activeCustomEditorId == markdownWysiwyg.editor"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@milkdown/crepe": "^7.5.0",
    "@milkdown/kit": "^7.5.0",
    "gemoji": "^8.1.0",
    "mermaid": "^12.3.0",
    "yaml": "^2.9.1"
  },
  "author": "Nicholas Peretti",
  "repository": {
    "type": "git",
    "url": "https://github.com/NicholasPeretti/markdown-wysiwyg.git"
  }
}
